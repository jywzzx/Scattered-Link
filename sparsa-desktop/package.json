{
  "name": "sparsa-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Sparsa 零星 · Vue 3 + Element Plus 桌面端",
  "author": "Sparsa",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app:dev": "concurrently -k -n VITE,SHELL -c cyan,magenta \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "app:start": "electron .",
    "app:run": "node_modules/electron/dist/electron.exe .",
    "app:dist": "npm run build && node build/package.mjs",
    "backend:build": "node build/compile-backend.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "element-plus": "^2.11.0",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "sass": "^1.83.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.sparsa.desktop",
    "productName": "Sparsa",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
